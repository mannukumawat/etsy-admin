# Admin panel environment (copy to .env.local). No secrets belong here:
# every VITE_* value is bundled into public JavaScript.

# --- Backend API ----------------------------------------------------------------------------------
# REQUIRED. The admin talks to the real backend (Express + Prisma + MySQL) through this URL:
# products, categories, media, orders, settings and owner sign-in all go through it.
#   Local:      VITE_API_BASE_URL=http://localhost:4000
#   Production: VITE_API_BASE_URL=https://your-backend.example.com
#
# There is no fallback: if this is unset, the admin refuses to boot (ConfigurationRequired)
# instead of running on in-memory demo data. If it is set and the backend is down, the admin
# shows an error instead of pretending a save succeeded.
VITE_API_BASE_URL=http://localhost:4000

# Where the "View store" link points.
VITE_STOREFRONT_URL=http://localhost:5173
# Production example: https://your-store.example.com

# Fraction (0–1) of *mock* service calls that fail on purpose, to exercise error/retry states.
# Only affects the dev/test-only mock layer; ignored for calls that go to the real API.
VITE_MOCK_FAILURE_RATE=0

# --- Firebase (admin app does not use Web Push, so no Firebase keys needed here) ----------------
# Firebase push is only needed for the customer storefront (frontend/.env.example).
