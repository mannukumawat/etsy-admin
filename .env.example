# Admin panel environment (copy to .env.local). No secrets belong here:
# every VITE_* value is bundled into public JavaScript.

# --- Catalog API ----------------------------------------------------------------------------------
# SET THIS to manage the real catalog through the backend (milestone 1): products, categories, media
# and owner sign-in all go to PostgreSQL.
#   VITE_API_BASE_URL=http://localhost:4000
# Leave it UNSET to run the admin entirely on in-memory demo data.
#
# There is no silent fallback: with this set, a backend that is down shows an error instead of
# pretending a save succeeded.
VITE_API_BASE_URL=http://localhost:4000

# Where the "View store" link points.
VITE_STOREFRONT_URL=http://localhost:5173

# Fraction (0–1) of *mock* service calls that fail on purpose, to exercise error/retry states.
# Ignored for calls that go to the real API.
VITE_MOCK_FAILURE_RATE=0
